---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	/** Optional short line above the title. */
	eyebrow?: string;
	image?: ImageMetadata;
}

const { title, description, eyebrow, image } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>

	<body>
		<Header />

		<main>
			<header class="page-title">
				{eyebrow && <p class="eyebrow">{eyebrow}</p>}
				<h1>{title}</h1>
			</header>

			{
				image && (
					<figure class="page-image">
						<Image src={image} alt="" width={1600} height={900} loading="eager" />
					</figure>
				)
			}

			<div class="prose">
				<slot />
			</div>
		</main>

		<Footer />
	</body>
</html>

<style>
	.page-title {
		max-width: var(--measure);
		margin-inline: auto;
		padding-bottom: clamp(2rem, 4vw, 3rem);
	}

	.page-title h1 {
		margin: 0.5rem 0 0 0;
		font-size: var(--step-4);
		font-weight: 700;
		letter-spacing: -0.028em;
	}

	.page-image {
		margin: 0 0 clamp(2.5rem, 5vw, 4rem) 0;
		border: 1px solid var(--stone);
		overflow: hidden;
	}

	.page-image :global(img) {
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	.prose {
		max-width: var(--measure);
		margin-inline: auto;
	}

	.prose :global(h2),
	.prose :global(h3) {
		margin-top: 2.5em;
	}
</style>
