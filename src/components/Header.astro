---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="wordmark" href="/">{SITE_TITLE}</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Work</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>

<!--
	Social links live here. The starter template shipped with Astro's own
	Mastodon/Twitter/GitHub accounts, which have been removed. To add yours,
	drop anchors into a <div class="social-links"> after .internal-links.
-->

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background-color: rgba(var(--slate-rgb), 0.85);
		backdrop-filter: blur(10px);
		border-bottom: var(--rule);
	}

	nav {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		max-width: 1180px;
		margin-inline: auto;
		padding: 1.1rem var(--gutter);
	}

	.wordmark {
		font-family: var(--font-archivo);
		font-size: var(--step-0);
		font-weight: 700;
		letter-spacing: 0.02em;
		color: var(--paper);
		text-decoration: none;
		transition: color var(--dur) var(--ease);
	}

	.wordmark:hover {
		color: var(--sage);
	}

	.internal-links {
		display: flex;
		gap: clamp(1rem, 3vw, 2rem);
	}
</style>
