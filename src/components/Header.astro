---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<!--
	First focusable thing on every page. Without it, anyone navigating by
	keyboard or screen reader tabs through the wordmark and all three nav links
	before reaching the content — on every single page. WCAG 2.4.1, Level A.
	It's invisible until focused.
-->
<a class="skip" href="#main">Skip to content</a>

<header>
	<nav>
		<a class="wordmark" href="/">{SITE_TITLE}</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/work">Work</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>

<style>
	.skip {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 20;
		/* Off-canvas rather than display:none, so it stays in the tab order. */
		transform: translateY(-120%);
		padding: 0.75rem 1.25rem;
		background-color: var(--brand);
		color: var(--ink);
		font-weight: 700;
		text-decoration: none;
		transition: transform var(--dur) var(--ease);
	}

	/* :focus, not :focus-visible — this link is only reachable by keyboard
	   anyway, and :focus covers programmatic focus from assistive tech too. */
	.skip:focus {
		transform: translateY(0);
	}

	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background-color: rgba(var(--ink-rgb), 0.85);
		backdrop-filter: blur(10px);
		border-bottom: var(--rule);
	}

	nav {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		/* Wraps rather than squashing: on a narrow phone the links drop to a
		   second line, which reads as intentional. A broken wordmark does not. */
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		max-width: var(--wide);
		margin-inline: auto;
		padding: 1.1rem var(--gutter);
	}

	.wordmark {
		font-family: var(--font-display);
		font-size: var(--step-0);
		font-weight: 700;
		letter-spacing: 0.01em;
		color: var(--paper);
		text-decoration: none;
		/* His name is the one string on the site that must never break. */
		white-space: nowrap;
		transition: color var(--dur) var(--ease);
	}

	@media (min-width: 30em) {
		.wordmark {
			font-size: var(--step-1);
		}
	}

	.wordmark:hover {
		color: var(--brand);
	}

	.internal-links {
		display: flex;
		gap: clamp(1rem, 3vw, 2rem);
	}
</style>
