---
import { SITE_ROLE, SITE_TITLE } from '../consts';

const today = new Date();
---

<footer>
	<div class="inner">
		<div class="mark">
			<span class="name">{SITE_TITLE}</span>
			<span class="eyebrow">{SITE_ROLE}</span>
		</div>

		<!--
			The starter template pointed these at Astro's own accounts.
			Removed. Add your own here when you're ready:
			<a href="https://instagram.com/you">Instagram</a>
		-->

		<p class="copyright">&copy; {today.getFullYear()} {SITE_TITLE}</p>
	</div>
</footer>

<style>
	footer {
		background-color: var(--ink);
		border-top: var(--rule);
	}

	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem;
		max-width: 1180px;
		margin-inline: auto;
		padding: clamp(2.5rem, 5vw, 4rem) var(--gutter);
	}

	.mark {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.name {
		font-family: var(--font-archivo);
		font-size: var(--step-1);
		font-weight: 700;
		letter-spacing: -0.015em;
		color: var(--paper);
	}

	.copyright {
		margin: 0;
		font-size: var(--step--1);
		color: var(--ash);
	}
</style>
