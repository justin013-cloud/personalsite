---
import { LINKS, SITE_ROLE, SITE_TITLE } from '../consts';

const today = new Date();
---

<footer>
	<div class="inner">
		<div class="mark">
			<span class="name">{SITE_TITLE}</span>
			<span class="eyebrow">{SITE_ROLE}</span>
		</div>

		<nav class="links" aria-label="Elsewhere">
			<a href={LINKS.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
			<a href={LINKS.vimeo} rel="me noopener" target="_blank">Vimeo</a>
			<a href={`mailto:${LINKS.email}`}>Email</a>
		</nav>

		<p class="copyright">&copy; {today.getFullYear()} {SITE_TITLE}</p>
	</div>
</footer>

<style>
	footer {
		background-color: var(--surface);
		border-top: var(--rule);
	}

	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem;
		max-width: var(--wide);
		margin-inline: auto;
		padding: clamp(2.5rem, 5vw, 4rem) var(--gutter);
	}

	.mark {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.name {
		font-family: var(--font-display);
		font-size: var(--step-2);
		font-weight: 700;
		color: var(--paper);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: clamp(1rem, 3vw, 2rem);
	}

	.links a {
		font-size: var(--step--1);
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		text-decoration: none;
		/*
			The footer sits on --surface, not --ink. --brand is only 4.36:1 there,
			which fails AA at this size; --brand-bright is 6.24:1. Any accent text
			placed on --surface needs this treatment.
		*/
		color: var(--brand-bright);
	}

	.copyright {
		margin: 0;
		font-size: var(--step--1);
		color: var(--ash);
	}
</style>
