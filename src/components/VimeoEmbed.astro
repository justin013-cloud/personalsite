---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { vimeoEmbedUrl, vimeoPoster } from '../lib/vimeo';

interface Props {
	/** Full Vimeo URL from the content file. */
	url: string;
	/** Used for the accessible label and the iframe title. */
	title: string;
	orientation?: 'horizontal' | 'vertical';
	/** Optional custom poster frame. Falls back to Vimeo's own thumbnail. */
	poster?: ImageMetadata;
	/** Set on the homepage reel so its poster is not lazy-loaded. */
	eager?: boolean;
}

const { url, title, orientation = 'horizontal', poster, eager = false } = Astro.props;

/*
	The player is not embedded until someone clicks. Five Vimeo iframes on one
	page is several megabytes and a slow first paint, and most visitors will only
	ever play one of them. So we render a poster and a button, and swap the real
	iframe in on demand.
*/
const embedUrl = vimeoEmbedUrl(url);
const remotePoster = poster ? null : await vimeoPoster(url);
const ratio = orientation === 'vertical' ? '9 / 16' : '16 / 9';
---

<div class="embed" data-embed data-src={embedUrl} data-title={title} style={`--ratio: ${ratio}`}>
	<button type="button" class="trigger" aria-label={`Play ${title}`}>
		{
			poster ? (
				<Image
					src={poster}
					alt=""
					widths={[640, 1280]}
					sizes="(max-width: 48em) 100vw, 60vw"
					loading={eager ? 'eager' : 'lazy'}
				/>
			) : remotePoster ? (
				<img src={remotePoster} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" />
			) : (
				/* Vimeo unreachable at build time, or the video is restricted.
				   A title card is a better failure than a broken image. */
				<span class="fallback">{title}</span>
			)
		}
		<span class="glyph" aria-hidden="true">
			<svg viewBox="0 0 24 24" fill="currentColor" width="28" height="28">
				<path d="M8 5v14l11-7z"></path>
			</svg>
		</span>
	</button>
</div>

<style>
	.embed {
		position: relative;
		aspect-ratio: var(--ratio);
		background-color: var(--surface);
		border: 1px solid var(--hairline);
		overflow: hidden;
		transition: border-color var(--dur) var(--ease);
	}

	.embed:hover {
		border-color: var(--brand);
	}

	.trigger {
		display: block;
		width: 100%;
		height: 100%;
		padding: 0;
		border: none;
		background: none;
		cursor: pointer;
		color: inherit;
	}

	.trigger :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.85;
		transition:
			opacity var(--dur) var(--ease),
			transform var(--dur) var(--ease);
	}

	.trigger:hover :global(img),
	.trigger:focus-visible :global(img) {
		opacity: 1;
		transform: scale(1.02);
	}

	.fallback {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		padding: 2rem;
		font-family: var(--font-display);
		font-size: var(--step-2);
		line-height: 1.1;
		color: var(--ash);
		text-align: center;
	}

	/* Play button. Sits over the poster, lifts to brand blue on hover. */
	.glyph {
		position: absolute;
		inset: 0;
		margin: auto;
		display: grid;
		place-items: center;
		width: 4.5rem;
		height: 4.5rem;
		border-radius: 50%;
		background-color: rgba(var(--ink-rgb), 0.72);
		border: 1px solid var(--paper);
		color: var(--paper);
		backdrop-filter: blur(4px);
		transition:
			background-color var(--dur) var(--ease),
			border-color var(--dur) var(--ease),
			transform var(--dur) var(--ease);
	}

	.glyph svg {
		/* optical centring — the triangle reads left-heavy when mathematically centred */
		margin-left: 0.2rem;
	}

	.trigger:hover .glyph,
	.trigger:focus-visible .glyph {
		background-color: var(--brand);
		border-color: var(--brand);
		transform: scale(1.06);
	}

	/* Once swapped in, the iframe fills the same box. */
	.embed :global(iframe) {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>

<script>
	// One listener set for every embed on the page. Clicking replaces the poster
	// with the real player, already set to autoplay so the click isn't wasted.
	document.querySelectorAll<HTMLElement>('[data-embed]').forEach((embed) => {
		const trigger = embed.querySelector('button');

		trigger?.addEventListener('click', () => {
			const iframe = document.createElement('iframe');
			iframe.src = embed.dataset.src ?? '';
			iframe.title = embed.dataset.title ?? 'Video';
			iframe.allow = 'autoplay; fullscreen; picture-in-picture';
			iframe.allowFullscreen = true;

			embed.replaceChildren(iframe);
			// Move focus into the player so keyboard users aren't stranded on a
			// button that no longer exists.
			iframe.focus();
		});
	});
</script>
