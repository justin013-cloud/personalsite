---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { LINKS } from '../consts';
import { about } from '../lib/about';

/*
	Everything on this page is edited in the CMS under Pages → About, and lives
	in src/data/about.json. Adding a job is adding an entry there — no code.

	Two things from Justin's resume are deliberately absent and should stay
	that way: his mobile number, and the four professional references. Those
	reference entries carry other people's personal phone numbers and private
	email addresses, and publishing them exposes people who never agreed to it.
	References belong in a PDF sent on request.
*/

const {
	metaDescription,
	pageEyebrow,
	pageTitle,
	profileLead,
	profileBody,
	historyHeading,
	awardsHeading,
	skillsHeading,
	educationHeading,
	contactHeading,
	jobs,
	awards,
	competencies,
	tools,
	education,
	contactPitch,
} = about;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={metaDescription} />
	</head>
	<body>
		<Header />

		<main>
			<header class="page-title">
				<p class="eyebrow">{pageEyebrow}</p>
				<h1>{pageTitle}</h1>
			</header>

			<section class="profile">
				<p class="lead">{profileLead}</p>
				<p>{profileBody}</p>
			</section>

			<section aria-labelledby="history-heading">
				<h2 id="history-heading" class="section-head">{historyHeading}</h2>
				<ol class="history">
					{
						jobs.map((job) => (
							<li>
								<div class="when">
									<span class="period">{job.period}</span>
								</div>
								<div class="what">
									<h3>{job.role}</h3>
									<p class="company">
										{job.company}
										{job.note && <span class="note">({job.note})</span>}
									</p>
									<ul>
										{job.points.map((point) => (
											<li>{point}</li>
										))}
									</ul>
								</div>
							</li>
						))
					}
				</ol>
			</section>

			<section aria-labelledby="awards-heading">
				<h2 id="awards-heading" class="section-head">{awardsHeading}</h2>
				<ul class="awards">
					{
						awards.map((award) => (
							<li>
								<span class="honor">{award.honor}</span>
								<span class="body">
									{award.body} · {award.year}
								</span>
								<span class="work">{award.work}</span>
							</li>
						))
					}
				</ul>
			</section>

			<section aria-labelledby="skills-heading">
				<h2 id="skills-heading" class="section-head">{skillsHeading}</h2>
				<div class="skills">
					<div>
						<h3>Core competencies</h3>
						<ul class="tags">
							{competencies.map((item) => <li>{item}</li>)}
						</ul>
					</div>
					<div>
						<h3>Tools &amp; software</h3>
						<ul class="tags">
							{tools.map((item) => <li>{item}</li>)}
						</ul>
					</div>
				</div>
			</section>

			<section aria-labelledby="education-heading">
				<h2 id="education-heading" class="section-head">{educationHeading}</h2>
				<p class="degree">{education.degree}</p>
				<p class="school">
					{education.school}{education.location && ` · ${education.location}`}
				</p>
			</section>

			<section aria-labelledby="contact-heading" class="contact">
				<h2 id="contact-heading" class="section-head">{contactHeading}</h2>
				<p class="pitch">{contactPitch}</p>
				<ul class="contact-links">
					<li><a href={`mailto:${LINKS.email}`}>{LINKS.email}</a></li>
					<li><a href={LINKS.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
					<li><a href={LINKS.vimeo} rel="me noopener" target="_blank">Vimeo</a></li>
				</ul>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.page-title {
		padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
	}

	.page-title h1 {
		margin: 0.5rem 0 0 0;
		font-size: var(--step-5);
	}

	section {
		padding-block: clamp(2rem, 5vw, 3.5rem);
		border-top: var(--rule);
	}

	.profile {
		border-top: none;
		padding-top: 0;
		max-width: var(--measure);
	}

	.lead {
		font-size: var(--step-2);
		font-family: var(--font-display);
		font-weight: 700;
		line-height: 1.15;
		color: var(--paper);
		text-wrap: pretty;
	}

	.profile p:not(.lead) {
		color: var(--ash);
		font-size: var(--step-1);
		line-height: 1.5;
	}

	.section-head {
		margin: 0 0 clamp(1.5rem, 3vw, 2.25rem) 0;
		font-size: var(--step-1);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ash);
	}

	/* --- History --- */

	.history {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: clamp(2rem, 4vw, 3rem);
	}

	.history > li {
		display: grid;
		gap: 0.5rem 2rem;
	}

	@media (min-width: 48em) {
		.history > li {
			grid-template-columns: 10rem 1fr;
		}
	}

	.period {
		font-size: var(--step--1);
		font-weight: 700;
		letter-spacing: 0.1em;
		color: var(--brand);
		font-variant-numeric: tabular-nums;
	}

	.what h3 {
		margin: 0;
		font-size: var(--step-1);
	}

	.company {
		margin: 0.25rem 0 0.75rem 0;
		font-size: var(--step-0);
		color: var(--paper);
	}

	.note {
		margin-left: 0.5em;
		font-size: var(--step--1);
		font-style: italic;
		color: var(--ash);
	}

	.what ul {
		margin: 0;
		padding-left: 1.1rem;
		display: grid;
		gap: 0.5rem;
		color: var(--ash);
	}

	.what ul li {
		padding-left: 0.25rem;
	}

	.what ul li::marker {
		color: var(--brand);
	}

	/* --- Awards --- */

	.awards {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
		gap: 1.5rem;
	}

	.awards li {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding-left: 0.9rem;
		border-left: 2px solid var(--brand);
	}

	.honor {
		font-size: var(--step--1);
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--brand);
	}

	.awards .body {
		color: var(--paper);
		font-weight: 700;
	}

	.work {
		font-style: italic;
		color: var(--ash);
	}

	/* --- Skills --- */

	.skills {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
		gap: clamp(1.5rem, 4vw, 3rem);
	}

	.skills h3 {
		margin: 0 0 1rem 0;
		font-size: var(--step-0);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ash);
	}

	.tags {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tags li {
		padding: 0.3em 0.75em;
		border: 1px solid var(--hairline);
		border-radius: 999px;
		font-size: var(--step--1);
		background-color: var(--surface);
	}

	/* --- Education & contact --- */

	.degree {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--step-1);
		font-weight: 700;
	}

	.school {
		margin: 0.35rem 0 0 0;
		color: var(--ash);
	}

	.pitch {
		margin: 0 0 1.25rem 0;
		font-size: var(--step-1);
		color: var(--paper);
	}

	.contact-links {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2rem;
	}

	.contact-links a {
		font-size: var(--step-1);
		font-weight: 700;
		text-decoration: none;
		border-bottom: 1px solid rgba(var(--brand-rgb), 0.4);
		padding-bottom: 0.2em;
	}

	.contact-links a:hover {
		border-bottom-color: currentColor;
	}
</style>
