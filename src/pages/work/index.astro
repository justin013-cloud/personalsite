---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import WorkRow from '../../components/WorkRow.astro';

const projects = (await getCollection('work', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.order - b.data.order || b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Work"
			description="Selected motion graphics, brand films, and video work by Justin D. Sims."
		/>
	</head>
	<body>
		<Header />

		<main id="main">
			<header class="page-title">
				<p class="eyebrow">Portfolio</p>
				<h1>Work</h1>
			</header>

			{projects.map((entry, i) => <WorkRow entry={entry} index={i} headingLevel={2} />)}
		</main>

		<Footer />
	</body>
</html>

<style>
	.page-title {
		padding-bottom: clamp(1rem, 3vw, 2rem);
	}

	.page-title h1 {
		margin: 0.5rem 0 0 0;
		font-size: var(--step-5);
	}
</style>
