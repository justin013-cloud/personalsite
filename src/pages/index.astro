---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import WorkGrid from '../components/WorkGrid.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<main>
			{/* PLACEHOLDER COPY — rewrite these three lines in your own words. */}
			<section class="hero">
				<p class="eyebrow" data-rise style="--i: 0">Design &amp; Motion</p>
				<h1 data-rise style="--i: 1">Graphic design and video, start to finish.</h1>
				<p class="lede" data-rise style="--i: 2">
					Identity, motion graphics, and short-form film. Selected work below.
				</p>
				<a class="jump" href="#work" data-rise style="--i: 3">See the work</a>
			</section>

			<section id="work" aria-labelledby="work-heading">
				<div class="section-head">
					<h2 id="work-heading">Selected work</h2>
					{posts.length > 6 && <a class="all" href="/blog">All work</a>}
				</div>
				<WorkGrid posts={posts} limit={6} />
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.hero {
		padding-block: clamp(2rem, 8vw, 6rem) clamp(3.5rem, 9vw, 7rem);
	}

	.hero h1 {
		/* ch on the h1 itself, so the measure tracks the display size.
		   Putting it on .hero measures against the 18px body font instead. */
		max-width: 15ch;
		font-size: var(--step-5);
		font-weight: 700;
		letter-spacing: -0.03em;
		margin: 0.5rem 0 0 0;
	}

	.lede {
		max-width: 34ch;
		margin: 1.5rem 0 0 0;
		font-size: var(--step-1);
		line-height: 1.45;
		color: var(--ash);
		text-wrap: pretty;
	}

	.jump {
		display: inline-block;
		margin-top: 2rem;
		font-family: var(--font-archivo);
		font-size: var(--step--1);
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--sage);
		border-bottom: 1px solid rgba(var(--sage-rgb), 0.35);
		padding-bottom: 0.35em;
		transition:
			color var(--dur) var(--ease),
			border-color var(--dur) var(--ease);
	}

	.jump:hover {
		color: var(--pale);
		border-bottom-color: currentColor;
	}

	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 1.5rem;
		margin-bottom: 2rem;
		border-bottom: var(--rule);
	}

	.section-head h2 {
		margin: 0;
		font-size: var(--step-1);
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ash);
	}

	.all {
		flex: none;
		font-family: var(--font-archivo);
		font-size: var(--step--1);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-decoration: none;
	}

	/*
		The one orchestrated moment on the page: hero lines rise in sequence.
		The reduced-motion block in global.css pins [data-rise] visible.
	*/
	[data-rise] {
		opacity: 0;
		animation: rise 620ms var(--ease) forwards;
		animation-delay: calc(var(--i) * 90ms);
	}
</style>
