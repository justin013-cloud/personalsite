---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import VimeoEmbed from '../components/VimeoEmbed.astro';
import WorkRow from '../components/WorkRow.astro';
import { SHOWREEL, SHOWREEL_LABEL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { home } from '../lib/home';

const featured = (await getCollection('work', ({ data }) => !data.draft && data.featured)).sort(
	(a, b) => a.data.order - b.data.order || b.data.date.valueOf() - a.data.date.valueOf(),
);

const total = (await getCollection('work', ({ data }) => !data.draft)).length;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<main>
			<!--
				The reel is the pitch, so the intro above it stays to two lines.
				Anything longer and the player drops below the fold on a laptop.
			-->
			<section class="hero">
				<div class="intro">
					<p class="eyebrow" data-rise style="--i: 0">{home.eyebrow}</p>
					<h1 data-rise style="--i: 1">{home.headline}</h1>
					<p class="lede" data-rise style="--i: 2">{home.lede}</p>
				</div>

				<div class="reel" data-rise style="--i: 3">
					<VimeoEmbed url={SHOWREEL} title={SHOWREEL_LABEL} eager />
				</div>
			</section>

			<section id="work" aria-labelledby="work-heading">
				<div class="section-head">
					<h2 id="work-heading">{home.workHeading}</h2>
					{featured.length < total && <a class="all" href="/work">All work</a>}
				</div>

				{featured.map((entry, i) => <WorkRow entry={entry} index={i} />)}

				<p class="tail">
					<a class="all" href="/work">See every project <span aria-hidden="true">&rarr;</span></a>
				</p>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	/*
		The reel is the pitch, so the intro is kept deliberately short — every
		line above it pushes the player further down the screen. At 1440x900 this
		keeps roughly three quarters of the reel above the fold; the name is set
		one step down from display size because the header wordmark is already
		carrying it.
	*/
	.hero {
		padding-block: clamp(1rem, 2vw, 1.75rem) clamp(3rem, 7vw, 5rem);
	}

	.intro {
		max-width: 64ch;
		margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
	}

	.intro h1 {
		margin: 0.4rem 0 0 0;
		font-size: var(--step-4);
		line-height: 1;
		letter-spacing: -0.015em;
	}

	.lede {
		margin: 0.9rem 0 0 0;
		max-width: 52ch;
		font-size: var(--step-1);
		line-height: 1.4;
		color: var(--ash);
		text-wrap: pretty;
	}

	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--paper);
	}

	.section-head h2 {
		margin: 0;
		font-size: var(--step-1);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.all {
		flex: none;
		font-size: var(--step--1);
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-decoration: none;
	}

	.tail {
		margin: 0;
		padding-top: clamp(2rem, 5vw, 3rem);
	}

	/*
		The one orchestrated moment on the site: the hero rises in sequence.
		The reduced-motion block in global.css pins [data-rise] visible.
	*/
	[data-rise] {
		opacity: 0;
		animation: rise 620ms var(--ease) forwards;
		animation-delay: calc(var(--i) * 90ms);
	}
</style>
